(defcfg
  danger-enable-cmd yes
)

(defvirtualkeys
  vkey-lalt lalt
  w-held f23
  y-held f23
  y-layer-a-key-alacritty (switch ((input virtual y-held)) (macro C-b 100 S-6) break () (macro y a) break)
  y-layer-a-key-default (switch  ((input virtual y-held)) C-w break () (macro y a) break)
  w-layer-m-key (switch  ((input virtual w-held)) M-A-S-m break () (macro w m) break)
  w-layer-n-key (switch  ((input virtual w-held)) (unicode ∫) break () (macro w n) break)
  w-layer-e-key (switch  ((input virtual w-held)) (unicode ∏) break () (macro w e) break)
  w-layer-g-key (switch  ((input virtual w-held)) M-A-S-g break () (macro w g) break)
  w-layer-i-key (switch  ((input virtual w-held)) M-A-S-i break () (macro w i) break)
  w-layer-u-key (switch  ((input virtual w-held)) M-A-S-u break () (macro w u) break)
  w-layer-p-key (switch  ((input virtual w-held)) M-A-S-p break () (macro w p) break)
  alacritty_active f23
  brave_active f23
  cursor_active f23
  fork_active f23
)

