(deflayer default-layer
  (tap-hold-press 100 200 caps (multi lmeta (layer-toggle lmeta-layer)))
  A-C-M-S-f7
  A-C-M-S-f8
  mute

  (tap-hold-press 100 1000 (switch  ((input virtual alacritty_active)) (cmd curl "http://127.0.0.1:9125/toggle-fork") break ((input virtual cursor_active)) (cmd curl "http://127.0.0.1:9125/toggle-fork") break ((input virtual fork_active)) (cmd curl "http://127.0.0.1:9125/toggle-fork") break () A-S-M-t break) (layer-toggle paragraph-layer)) ;; | alacritty: tmux – close pane |     
  (layer-toggle char-variation-layer)
  (tap-hold-press 100 200 ` (layer-toggle oe-layer))
  3
  4
  5
  6
  7
  (cmd C:\Progra~1\AutoHotKey\v2\AutoHotKey64.exe \\wsl.localhost\Ubuntu\home\olof\.local\bin\position-windows.ahk)
  8
  (tap-hold-press 100 200 ' (multi lalt (layer-toggle ae-layer)))
  (macro (cmd C:\PortableApps\nircmd\nircmd.exe setcursor 200 1500) 10 (cmd C:\PortableApps\nircmd\ahk-click.exe) 100 (cmd C:\PortableApps\nircmd\nircmd.exe setcursor 1570 700) (cmd curl "http://127.0.0.1:9125/focus?app=brave&profile=personal"))
  (macro (cmd C:\PortableApps\nircmd\nircmd.exe setcursor 1130 2580) 10 (cmd C:\PortableApps\nircmd\ahk-click.exe) 100 (cmd C:\PortableApps\nircmd\nircmd.exe setcursor 2900 1000) (cmd curl "http://127.0.0.1:9125/focus?app=brave&profile=personal")) 
  volu

  q
  (tap-hold-press 100 200 w (multi (layer-while-held w-layer) (on-press press-vkey w-held) (on-release release-vkey w-held)))
  f
  p
  b
  6
  XX
  j
  l
  u
  (tap-hold-press 100 200 y (multi (layer-toggle y-layer) (on-press press-vkey y-held) (on-release release-vkey y-held) (on-release release-vkey vkey-lalt)))
  -
  S-7

