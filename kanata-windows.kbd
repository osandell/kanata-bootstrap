(deflayer special1-layer
  _
  _
  _
  _

  _
  _
  tab
  (multi (release-key lctl) s)
  _
  _
  _
  _
  _
  _
  (multi (release-key lctl) C--)
  (multi (release-key lctl) C-+)
  _
  (multi (release-key lctl) (cmd c:\PortableApps\Studi\studi.exe up) (cmd c:\portableapps\nircmd\nircmd.exe changebrightness +5))

  (multi (release-key lctl) s)
  C-z
  C-S-z
  C-s
  _
  _
  _
  (switch  ((input virtual alacritty_active)) C-b break ((input virtual cursor_active)) C-b break) ;; | alacritty: tmux leader | cursor: toggle right bar |
  (switch  ((input virtual alacritty_active)) C-l break ((input virtual brave_active)) (multi (release-key lctl) f12) break ((input virtual cursor_active)) C-l break) ;; | alacritty: soft clear | brave: toggle inspector | cursor: toggle chat bar |
  (switch  ((input virtual alacritty_active)) C-r break ((input virtual cursor_active)) A-C-S-M-u break) ;; | alacritty: history search | cursor: new file |
  (switch  ((input virtual alacritty_active)) (macro C-b 100 RA-8) break ((input virtual cursor_active)) A-C-S-M-y break) ;; | alacritty: tmux vi mode | cursor: new dir |
  C-S-p
  _

  (tap-hold 100 200 (switch ((input virtual alacritty_active)) (multi (release-key lctl) (macro f z f ret)) break ((input virtual brave_active)) l break ((input virtual cursor_active)) S-f break () C-f break) (layer-toggle special1-a-layer)) ;; | TAP | alacritty: fuzzy find file | brave: focus url bar | cursor: find in procject | default: find |
  (tap-hold 100 200 C-x (layer-toggle special1-r-layer))
  C-c
  C-v
  _
  _
  _
  (multi (release-key lctl) left)
  (multi (release-key lctl) down)
  (multi (release-key lctl) up)
  (multi (release-key lctl) rght)
  (switch  ((input virtual alacritty_active)) (macro C-b 100 spc) break ((input virtual brave_active)) C-S-x break ((input virtual cursor_active)) A-C-o break () C-o break) ;; | alacritty: tmux-thumbs (copy from scrollback) | brave: open 1password | cursor: open file | default: open |
  (tap-hold 100 200 (switch ((input virtual cursor_active)) C-' break) (switch ((input virtual cursor_active)) (multi (release-key lalt) C-S-') break )) ;; | TAP | cursor: comment | HOLD | cursor: wrap comment 
  (multi (release-key lctl) (cmd c:\PortableApps\Studi\studi.exe down) (cmd c:\portableapps\nircmd\nircmd.exe changebrightness -5))


  (multi (release-key lctl) (macro f24 C-c))
  (multi (release-key lctl) (switch ((input virtual brave_active)) A-left break)) ;; | brave: navigate back |
  (multi (release-key lctl) (switch ((input virtual brave_active)) A-right break)) ;; | brave: navigate forward |
  (multi (release-key lctl) f5)
  (multi (release-key lctl) C-a)
  _
  _
  (multi (release-key lctl) C-bspc)
  (tap-hold 100 200 (switch ((input virtual alacritty_active)) l break () k break) (switch ((input virtual alacritty_active)) (multi (release-key lctl) (macro c l e a r ret)) break)) ;; | TAP | alacritty: soft clear | default: ctrl-k (edit code in Cursor, leader in GitHub) | HOLD | alacritty: hard clear |
  _
  _
  A-x
  _
  C-S-e
  _
  (multi (release-key lctl) S-del)
  _
  (tap-hold 100 200 (multi (release-key lctl) lmet) (layer-toggle special1-tab))
  (tap-hold 100 200 (switch  ((input virtual cursor_active)) S-p break) (layer-toggle special1-space-layer)) ;; | TAP | cursor: command palette |
  _
  _
  _
  _
)


